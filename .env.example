# Google Gemini API key (required — the app fails fast without it)
GEMINI_API_KEY=AIzaSyAsy4y2h-LI5wr_GCmhU_BBVlkc-K_QMDM

# Gemini model id
GEMINI_MODEL=gemini-1.5-flash

# SQLAlchemy async database URL
DATABASE_URL=sqlite+aiosqlite:///./multivisions.db

# Directory holding company.json / products.json / pricing.json
DATA_DIR=./data

# Comma-separated allowed CORS origins (frontend)
BACKEND_CORS_ORIGINS=http://localhost:3000

# Frontend env (used by Next.js as NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_API_URL=http://localhost:8000
